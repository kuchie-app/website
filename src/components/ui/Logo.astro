---
/** The Bookmark Scarf app icon plus the wordmark. */
interface Props {
  href: string;
  size?: number;
}

const { href, size = 28 } = Astro.props;
---

<a class="logo" href={href} aria-label="Kuchie">
  <img src="/favicon.svg" alt="" width={size} height={size} />
  <span>Kuchie</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .logo img {
    border-radius: 22.5%;
    transition: transform var(--slow) var(--ease);
  }

  .logo:hover img {
    transform: rotate(-6deg);
  }
</style>
