---
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { localizedPath } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { links, nav } from '../../data/site';

interface Props {
  slug: string;
  path: string;
}

const { slug, path } = Astro.props;
const t = useTranslations(slug);
const current = path.split('/')[0];
---

<header class="hdr" data-header>
  <div class="wrap hdr__inner">
    <Logo href={localizedPath(slug)} />

    <nav class="hdr__nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={localizedPath(slug, item.path)} aria-current={item.path.split('/')[0] === current ? 'page' : undefined}>
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="hdr__end">
      <LangSwitcher slug={slug} path={path} />
      <ThemeToggle slug={slug} />
      <a class="icon-btn hide-sm" href={links.github} aria-label="GitHub" rel="noopener">
        <Icon name="github" size={18} />
      </a>
      <a class="btn btn-primary btn-sm" href={localizedPath(slug, 'download')}>{t('nav.download')}</a>

      <details class="hdr__menu" data-close-outside>
        <summary class="icon-btn" aria-label={t('nav.menu')}>
          <Icon name="menu" size={18} class="when-closed" />
          <Icon name="close" size={18} class="when-open" />
        </summary>
        <nav class="hdr__panel" aria-label="Main">
          {nav.map((item) => <a href={localizedPath(slug, item.path)}>{t(item.key)}</a>)}
          <a href={links.github} rel="noopener">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--mid) var(--ease),
      border-color var(--mid) var(--ease);
  }

  .hdr:global(.is-scrolled) {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: var(--line);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header);
  }

  .hdr__nav {
    display: flex;
    gap: 4px;
  }

  .hdr__nav a {
    padding: 6px 12px;
    border-radius: 8px;
    color: var(--text-2);
    font-size: 14px;
    transition:
      color var(--fast),
      background-color var(--fast);
  }

  .hdr__nav a:hover,
  .hdr__nav a[aria-current='page'] {
    color: var(--text);
    background: var(--raised);
  }

  .hdr__end {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
  }

  .hdr__end .btn {
    margin-inline-start: 8px;
  }

  .hdr__menu {
    display: none;
    position: relative;
  }

  .hdr__menu :global(.when-open),
  .hdr__menu[open] :global(.when-closed) {
    display: none;
  }

  .hdr__menu[open] :global(.when-open) {
    display: block;
  }

  .hdr__panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 12px);
    display: grid;
    min-width: 208px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.5);
    animation: hdr-pop 200ms var(--ease);
  }

  .hdr__panel a {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 15px;
  }

  .hdr__panel a:hover {
    background: var(--raised);
  }

  @keyframes hdr-pop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (max-width: 900px) {
    .hdr__nav {
      display: none;
    }

    .hdr__menu {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .hide-sm {
      display: none;
    }
  }
</style>
