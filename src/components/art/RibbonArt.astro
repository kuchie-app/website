---
/**
 * Static Bookmark Scarf illustrations for pages without Motion.
 * `scene`: "night" (back cover), "rest" (coming soon), "lost" (404).
 */
interface Props {
  scene: 'night' | 'rest' | 'lost';
  class?: string;
}

const { scene, class: className } = Astro.props;
const SCARF = 'M23 92c14-12 18-29 28-42 13-18 31-23 54-24L94 40l13 11c-19 0-30 5-40 17-9 11-13 23-25 32l-2-13z';
const PAPER = 'm31 70 5-28 23-10c-9 7-16 18-21 29z';
---

{
  scene === 'night' && (
    <svg class={className} viewBox="0 0 240 200" aria-hidden="true">
      <circle cx="180" cy="46" r="20" fill="#f4f0ea" />
      <circle cx="186" cy="42" r="20" fill="#18142d" opacity="0.18" />
      <g class="ribbon-art__float" transform="translate(30 30) scale(1.3)">
        <path d={SCARF} fill="#b5aaff" />
        <path d={PAPER} fill="#f4f0ea" />
      </g>
      <path d="M0 178h20v-16h24v10h16v-26h28v20h14v-12h26v16h16v-22h32v18h14v-8h50v42H0z" fill="#0d0b1c" />
    </svg>
  )
}
{
  scene === 'rest' && (
    <svg class={className} viewBox="0 0 240 200" aria-hidden="true">
      <path d="M40 170 h160" stroke="currentColor" stroke-opacity="0.2" stroke-width="2" />
      <rect x="62" y="132" width="116" height="16" rx="2" fill="#f4f0ea" stroke="#18142d" stroke-width="2" />
      <rect x="54" y="148" width="132" height="22" rx="2" fill="#e9e3da" stroke="#18142d" stroke-width="2" />
      <g transform="translate(58 22) scale(0.95)">
        <path d={SCARF} fill="#b5aaff" stroke="#18142d" stroke-width="3" stroke-linejoin="round" />
        <path d={PAPER} fill="#f4f0ea" stroke="#18142d" stroke-width="2.5" stroke-linejoin="round" />
      </g>
    </svg>
  )
}
{
  scene === 'lost' && (
    <svg class={className} viewBox="0 0 240 200" aria-hidden="true">
      <path d="M10 180 C 50 150, 30 110, 80 100 S 140 130, 150 80" fill="none" stroke="#b5aaff" stroke-width="2" stroke-dasharray="4 6" />
      <g transform="translate(118 10) scale(0.8) rotate(24 64 64)">
        <path d={SCARF} fill="#b5aaff" stroke="#18142d" stroke-width="3" stroke-linejoin="round" />
        <path d={PAPER} fill="#f4f0ea" stroke="#18142d" stroke-width="2.5" stroke-linejoin="round" />
      </g>
    </svg>
  )
}
